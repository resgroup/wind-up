# Copy to .env (git ignores it) and uncomment what you want to change. Unset variables keep their
# defaults; a variable already set in your shell wins over this file.

# Where Zenodo open data (Hill of Towie, Kelmarsh, Penmanshiel) is downloaded and unpacked, one
# zenodo/<record id> directory per record: tens of GB for the prepost campaign matrix.
# Default: ~/temp/wind-up-benchmarking/data
# WIND_UP_BENCHMARKING_DATA_DIR=/path/to/zenodo-data

# Where benchmark studies and campaign runs write. Default: ~/temp/wind-up-benchmarking
# WIND_UP_BENCHMARKING_OUTPUT_DIR=/path/to/outputs

# The reanalysis (ERA5) cache. Default: ~/.cache/wind_up
# WIND_UP_CACHE_DIR=/path/to/cache
